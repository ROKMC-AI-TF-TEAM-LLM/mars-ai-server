# ============================================================
# 개발 노트북(Windows) 전용 .env 템플릿
# 사용: Copy-Item .env.dev.example .env   (dev_setup.ps1이 자동 수행)
# L40 운영 배포 시에는 .env.example을 기준으로 작성할 것
# ============================================================

# LLM: llama.cpp 개발 서버 (serving/start_llm_dev.ps1) — vLLM과 동일 계약
AX_BASE_URL=http://localhost:8000/v1
AX_MODEL_NAME=skt/A.X-4.0-Light
AX_API_KEY=EMPTY

# --- 외부 LLM (시연 전용, OpenRouter) ---
# ⚠️ 에어갭 예외. true면 위 A.X 대신 이 API를 쓴다 — 질의·검색 청크가 외부로 나간다.
# 내부망 배포에서는 반드시 false. 임베딩·리랭커는 그대로 로컬 서버가 필요하다
EXTERNAL_LLM_ENABLED=false
EXTERNAL_LLM_BASE_URL=https://openrouter.ai/api/v1
EXTERNAL_LLM_MODEL_NAME=
EXTERNAL_LLM_API_KEY=

# 임베딩/리랭커: GPU는 llama.cpp가 쓰므로 CPU로
EMBEDDING_SERVER_URL=http://localhost:8001/embed
EMBEDDING_DEVICE=cpu
EMBEDDING_MODEL_PATH=./models/bge-m3
RERANKER_SERVER_URL=http://localhost:8002/rerank
RERANKER_DEVICE=cpu
RERANKER_MODEL_PATH=./models/bge-reranker-v2-m3
RERANK_TOP_K=20
RERANK_TOP_N=5
RERANK_SCORE_THRESHOLD=0.1

# 벡터DB: 운영과 같은 Milvus Lite (Docker 불필요).
# milvus-lite 3.x는 이 경로에 **디렉터리**를 만들지만, pymilvus가 URI를 검증하므로
# 경로는 반드시 .db로 끝나야 한다.
# Windows에서 프로젝트 경로에 한글(예: 사용자명)이 있으면 faiss가 인덱스 파일을 못 써
# ("Illegal byte sequence") 컬렉션 load가 실패한다 — 그때는 C:/mars_data/milvus_ax.db처럼
# ASCII 절대 경로로 지정한다
MILVUS_LITE_PATH=./data/milvus_ax.db
MILVUS_COLLECTION=company_docs

BM25_INDEX_PATH=./data/bm25_index
# Kiwi 모델 경로. Windows 사용자명 등 경로에 한글이 있으면 Kiwi가 모델을 못 연다
# ("Cannot open extract.mdl"). 그때 .venv\Lib\site-packages\kiwipiepy_model 폴더를
# ASCII 경로로 복사하고 여기에 지정한다. 비우면 패키지 기본 경로
KIWI_MODEL_PATH=
MAX_VERIFY_RETRY=1
HISTORY_MAX_TOKENS=1500
GENERATE_TEMPERATURE=0.2

# 검색 근거가 0건일 때(도메인 미지정 한정) LLM 자체 지식으로 답할지.
# ⚠️ verify를 거치지 않는 경로다 — SSE notice(ungrounded_knowledge) 경고가 함께 나간다
KNOWLEDGE_FALLBACK_ENABLED=true

# --- ReAct 에이전트 루프 (docs/react_migration_plan.md) ---
# 상한은 운영과 같은 값을 쓴다 — 개발에서 검증한 로직과 배포되는 로직을 일치시킨다.
# 노트북에서 너무 느리면 3/2 → 2/1로 낮출 수 있지만, MAX_SEARCH_CALLS=1이면
# **검증 반려 후 재검색**(ReAct의 핵심 이득)이 발동하지 않아 그 경로를 못 본다
MAX_AGENT_STEPS=3
MAX_SEARCH_CALLS=2
AGENT_VERIFY_FEEDBACK=true
# 판단 근거(thought)를 SSE status에 실어 보낸다. 개발에서는 켜 두면
# 프론트 없이도 curl로 루프가 어떻게 도는지 눈으로 확인할 수 있다
STREAM_THOUGHTS=true

AUDIT_LOG_PATH=./data/audit_log.jsonl
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
EXPORT_TTL_HOURS=24
# CPU 임베딩이 느려 timeout을 넉넉하게 (운영 기본 60)
HTTP_TIMEOUT_SECONDS=180
LOG_LEVEL=DEBUG
STREAM_TEXT_INTERVAL_MS=200

# 오프라인 강제 (모델은 로컬 경로에서만)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
LANGGRAPH_CLI_NO_ANALYTICS=1

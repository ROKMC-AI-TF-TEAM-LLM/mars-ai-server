# --- A.X 모델 서빙 (L40, vLLM) ---
AX_BASE_URL=http://localhost:8000/v1
AX_MODEL_NAME=skt/A.X-4.0-Light        # 오프라인 반입 후엔 로컬 경로로 교체
AX_API_KEY=EMPTY

# --- 임베딩 서버 (BGE-M3) ---
EMBEDDING_SERVER_URL=http://localhost:8001/embed
EMBEDDING_DEVICE=cuda
EMBEDDING_MODEL_PATH=./models/bge-m3            # 오프라인 반입된 로컬 경로 (Hub ID 금지)

# --- 리랭커 서버 (bge-reranker-v2-m3) ---
RERANKER_SERVER_URL=http://localhost:8002/rerank
RERANKER_DEVICE=cuda
RERANKER_MODEL_PATH=./models/bge-reranker-v2-m3 # 오프라인 반입된 로컬 경로 (Hub ID 금지)
RERANK_TOP_K=20
RERANK_TOP_N=5
# 리랭크 점수 하한(0~1). 미만 후보는 근거·출처에서 제외. 0=비활성
RERANK_SCORE_THRESHOLD=0.5

# --- Milvus Lite (임베디드) ---
MILVUS_LITE_PATH=./data/milvus_ax.db
MILVUS_COLLECTION=company_docs

# --- BM25 키워드 검색 ---
BM25_INDEX_PATH=./data/bm25_index

# --- 하이브리드 검색 (dense/bm25 각각의 검색 깊이) ---
SEARCH_TOP_K=20

# --- 파이프라인 ---
MAX_VERIFY_RETRY=1
HISTORY_MAX_TOKENS=1500
# generate(답변 생성) 전용 온도. 라우터·검증은 0 고정 (분류·판정 재현성)
GENERATE_TEMPERATURE=0.2

# 검색 근거가 0건일 때(도메인 미지정 한정) 정형 사과 문구 대신 LLM 자체 지식으로
# 답할지. true면 SSE notice(code=ungrounded_knowledge) 경고가 답변에 따라붙는다.
# ⚠️ 이 경로는 verify를 거치지 않는다 — 프론트가 notice를 표시하지 않는 상태로 켜지 말 것
KNOWLEDGE_FALLBACK_ENABLED=true

# --- ReAct 에이전트 루프 (docs/react_migration_plan.md) ---
# true면 agent ⇄ act 루프, false면 기존 plan-then-execute 그래프.
# L40 A/B 측정용 스위치이며, 승격 판단이 끝나면 한쪽을 삭제한다
AGENT_MODE=true
# 도구 호출 라운드 상한 (무한 루프 = 토큰 예산 파괴)
MAX_AGENT_STEPS=3
# 검색 호출 상한. 검색이 가장 비싼 행동(임베딩+BM25+리랭커 왕복)이라 따로 둔다
MAX_SEARCH_CALLS=2
# 검증 반려 사유를 에이전트에게 되돌려 재검색을 한 번 더 시도할지.
# 끄면 반려 시 종전대로 generate만 재실행한다 (지연이 문제일 때)
AGENT_VERIFY_FEEDBACK=true
# 에이전트 판단 근거(thought)를 SSE status 이벤트에 실어 보낼지.
# ⚠️ thought는 verify를 거치지 않는 LLM 자유 생성이다 — 문제가 생기면 이걸로 끈다
STREAM_THOUGHTS=true

# --- 감사 로그 ---
AUDIT_LOG_PATH=./data/audit_log.jsonl

# --- 자기 자신(MARS API) 주소. 평가·비교 스크립트 전용, 서버 코드는 쓰지 않는다 ---
MARS_SERVER_URL=http://localhost:9000

# --- 문서 업로드 저장 경로 (POST /documents 원본 보관) ---
UPLOAD_DIR=./data/uploads

# --- 생성 문서(HWPX 등) 저장 경로 (GET /files/{파일명}로 다운로드) ---
EXPORT_DIR=./data/exports

# --- 생성 문서 보관 시간(시간). 새 파일 생성 시 만료분 자동 정리. 0=비활성 ---
EXPORT_TTL_HOURS=24

# --- 외부 서비스 호출 공통 timeout(초). CPU 임베딩 등 느린 환경은 늘린다 ---
HTTP_TIMEOUT_SECONDS=60

# --- 로그 레벨 ---
LOG_LEVEL=INFO

# --- SSE text 이벤트 간 전송 간격(ms), 체감 스트리밍용 ---
STREAM_TEXT_INTERVAL_MS=200

# --- 오프라인/에어갭 필수 ---
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# --- 개발 노트북에서 langgraph dev 쓸 때만 ---
LANGGRAPH_CLI_NO_ANALYTICS=1
